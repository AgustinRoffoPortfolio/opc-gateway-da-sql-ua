<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Gateway.Core\Gateway.Core.csproj" />
    <ProjectReference Include="..\Gateway.Da\Gateway.Da.csproj" />
    <ProjectReference Include="..\Gateway.Sql\Gateway.Sql.csproj" />
    <ProjectReference Include="..\Gateway.Ua\Gateway.Ua.csproj" />
    <ProjectReference Include="..\Gateway.Web\Gateway.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Override local de credenciales (V2-26), opcional y no versionado
         (.gitignore). Condition evita que el build falle en una maquina donde
         el desarrollador no lo creo todavia. CopyToPublishDirectory=Never:
         dotnet run lo necesita en el output de build, pero el paquete
         publicado no puede llevarse las credenciales reales de quien publica
         (V2-26). -->
    <Content Include="appsettings.Local.json" Condition="Exists('appsettings.Local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <!-- Plantilla versionada del override local (V2-26): sin valores reales,
         viaja al output y al paquete publicado para que quien despliegue sepa
         que copiar y completar. -->
    <Content Include="appsettings.Local.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- El CSV de ejemplo viaja con la salida para que el paquete publicado
         sea autocontenido: sin esto, ConfigPathResolver.Resolve() lo encuentra
         subiendo hasta el repo y el gateway parece funcionar, pero explota en
         cualquier maquina donde el repo no este. Link conserva la subcarpeta
         config/, que es la ruta que espera TagsCsvPath en appsettings.json. -->
    <Content Include="..\..\config\tags.example.csv" Link="config\tags.example.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
